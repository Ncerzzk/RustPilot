<mujoco model="Skydio X2 scene">
  <include file="x2.xml"/>

  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
<!-- 
    <geom name="wall1" type="box" size="1.7 0.01 0.8" pos="0 1.7 0.8" />
    <geom name="wall2" type="box" size="1.7 0.01 0.8" pos="0 -1.7 0.8"/>
    <geom name="wall3" type="box" size="0.01 1.7 0.8" pos="1.7 0 0.8" />
    <geom name="wall4" type="box" size="0.01 1.7 0.8" pos="-1.7 0 0.8"/> -->

    <geom name="cylinder_obstacle1" type="cylinder" size="0.2 1.5" pos="2 2 0" rgba="0.8 0.2 0.2 1" />
    <geom name="cylinder_obstacle2" type="cylinder" size="0.3 2.4" pos="1 2 0" rgba="0.8 0.2 0.2 1"/>
    <geom name="cylinder_obstacle3" type="cylinder" size="0.2 1.4" pos="2 1 0" rgba="0.8 0.2 0.2 1"/>
    <geom name="cylinder_obstacle4" type="cylinder" size="0.3 3.4" pos="-2 1 0" rgba="0.8 0.2 0.2 1"/>
    <geom name="cylinder_obstacle5" type="cylinder" size="0.5 1.4" pos="-2 -1 0" rgba="0.8 0.2 0.2 1"/>

    <geom name="box_obstacle1" pos="1 -1 0" type="box" size="0.3 0.3 1.3" rgba="0.2 0.8 0.2 1"/>
    <geom name="box_obstacle2" pos="-1 1 0" type="box" size="0.25 0.25 1.25" rgba="0.2 0.8 0.2 1"/>

  </worldbody>
</mujoco>
